{
  "name": "pokemon-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "postinstall": "prisma generate",
    "vercel-build": "npx prisma migrate deploy && next build"
  },
  "dependencies": {
    "next": "14.3.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@prisma/client": "5.6.0",
    "zod": "4.24.0",
    "tailwindcss": "3.5.0",
    "postcss": "8.4.24",
    "autoprefixer": "10.4.14",
    "next-auth": "4.22.1",
    "@next-auth/prisma-adapter": "1.0.5"
  },
  "devDependencies": {
    "prisma": "5.6.0",
    "typescript": "5.6.0",
    "ts-node": "10.9.1"
  }
}
