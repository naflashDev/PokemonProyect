{
  "name": "pokemon-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest",
    "test:unit": "vitest",
    "test:integration": "cross-env RUN_INTEGRATION=1 vitest --run test/integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "postinstall": "prisma generate",
    "vercel-build": "npx prisma migrate deploy && next build"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.0",
    "@prisma/client": "^5.6.0",
    "autoprefixer": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.1.0",
    "next-auth": "^4.0.0",
    "postcss": "^8.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "cross-env": "^7.0.3",
    "prisma": "^5.6.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.0",
    "vitest": "^4.0.16"
  }
}
