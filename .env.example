## Local/Postgres example (recommended for production):
DATABASE_URL="postgresql://postgres:password@localhost:5432/pokemon_db?schema=public"

# Local SQLite fallback (development):
# DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changeme"

# GitHub OAuth (create App and paste values here)
GITHUB_ID=""
GITHUB_SECRET=""
# Production example values for Vercel (set these in Vercel Project > Settings > Environment Variables)
# NEXTAUTH_URL should be set to the Vercel deployment URL, e.g. https://your-app.vercel.app
# NEXTAUTH_SECRET must be a long random string. Do NOT commit secrets to the repo.

# Example Vercel env vars (do not add secrets to the repo):
# DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/<db>?schema=public
# NEXTAUTH_URL=https://your-app.vercel.app
# NEXTAUTH_SECRET=your_production_secret
# GITHUB_ID=xxxx
# GITHUB_SECRET=xxxx
